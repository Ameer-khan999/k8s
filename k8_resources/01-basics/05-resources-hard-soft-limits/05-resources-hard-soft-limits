apiVersion: v1
kind: Pod
metadata:
  name: resource-limit
  labels:
    project: roboshop
spec:
  containers:
  - name: nginx
    image: nginx
    resources:
      requests: # soft limit
        cpu: "100m" # 1 CPU
        memory: "128Mi"
      limits: # hard limit
        cpu: "150m"
        memory: "256Mi"
